[connection signal="draw" from="UI/Menus/AudioIcon/audioSettings/Panel/MarginContainer/VBoxContainer/SFXSlider" to="UI/Menus/AudioIcon/audioSettings/Panel/MarginContainer/VBoxContainer/SFXSlider" method="_on_draw"]
[connection signal="pressed" from="UI/Menus/upgrade_choice/VBoxContainer/AcceptButton" to="UI/Menus/upgrade_choice" method="find_focussed_panel"]
[connection signal="pressed" from="UI/Menus/upgrade_choice/dice_upgrade_display/VBoxContainer2/Button" to="UI/Menus/upgrade_choice/dice_upgrade_display" method="accept"]
[connection signal="visibility_changed" from="UI/Informative/Help_Panel" to="UI/Informative/Help_Panel/HBoxContainer/ClassesPanel" method="display_help"]
[connection signal="visibility_changed" from="UI/Informative/Help_Panel" to="UI/Informative/Help_Panel/HBoxContainer/ClassesPanel" method="set_display_lines"]
[connection signal="pressed" from="UI/Informative/Help_Panel/HBoxContainer/VBoxContainer/QuitButton" to="UI/Informative/Help_Panel/HBoxContainer/VBoxContainer/QuitButton" method="exit_game"]
[connection signal="pressed" from="UI/Informative/HelpIcon/Button" to="UI/Informative/Help_Panel" method="toggle_display"]
